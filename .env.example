# Copy to `.env` and adjust for your host.
# Used by compose.yml for port/volume substitution and passed into the container.

# Host port published to the container's :8000
ZZK_HOST_PORT=5163

# Persistent directories on the host
ZZK_DATA_DIR=/srv/zzk/data
ZZK_RECORDINGS_DIR=/srv/zzk/recordings

# Container timezone (logs, ffmpeg timestamps)
TZ=Asia/Seoul
